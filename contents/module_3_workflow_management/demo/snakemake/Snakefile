# Zurich newborn-names analysis from Module 2:
# 1. Python downloads and cleans the source data    → work/1_names_clean.csv
# 2. R selects yearly winners, retaining ties       → work/2_yearly_winners.csv
# 3. Polars prepares both plot datasets             → work/3_*.csv
# 4. Quarto renders the adapted Module 2 report     → results/4_report.html
#
# Run with:  snakemake --cores 1
# Run from any directory with:
#   snakemake --snakefile /path/to/Snakefile --cores 1

# Absolute path to this Snakefile's directory — keeps all paths stable
# regardless of where snakemake is invoked from.
D = workflow.basedir
DATA_URL = "https://data.stadt-zuerich.ch/dataset/bev_vornamen_baby_od3700/download/BEV370OD3700.csv"

rule all:
    input:
        f"{D}/results/4_report.html"


rule clean_names:
    input:
        script=f"{D}/1_clean.py",
    output:
        f"{D}/work/1_names_clean.csv",
    params:
        url=DATA_URL,
    shell:
        "python3 {input.script:q} --url {params.url:q} --output {output:q}"


rule summarize_yearly:
    input:
        data=f"{D}/work/1_names_clean.csv",
        script=f"{D}/2_summarize.R",
    output:
        f"{D}/work/2_yearly_winners.csv",
    shell:
        "Rscript {input.script:q} --input {input.data:q} --output {output:q}"


rule prepare_plots:
    input:
        data=f"{D}/work/1_names_clean.csv",
        script=f"{D}/3_prepare_plots.py",
    output:
        top_names=f"{D}/work/3_top_names.csv",
        selected_names=f"{D}/work/3_selected_names.csv",
    shell:
        "python3 {input.script:q} --input {input.data:q} "
        "--top-names-output {output.top_names:q} "
        "--selected-names-output {output.selected_names:q}"


rule final_report:
    input:
        qmd=f"{D}/4_report.qmd",
        clean=f"{D}/work/1_names_clean.csv",
        winners=f"{D}/work/2_yearly_winners.csv",
        top_names=f"{D}/work/3_top_names.csv",
        selected_names=f"{D}/work/3_selected_names.csv",
    output:
        f"{D}/results/4_report.html",
    params:
        basedir=D,
    shell:
        "cd {params.basedir} && quarto render 4_report.qmd --to html && mkdir -p results && mv 4_report.html results/"
