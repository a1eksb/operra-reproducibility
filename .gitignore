# Excludes local editor state, generated Quarto output, and workflow scratch files from Git.

# Editor / OS
.DS_Store
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto build output
.quarto/
_site/
_freeze/
*.quarto_ipynb
# Per-document figure/asset dirs; regenerated by every render, never deployed.
**/*_files/

# Claude Code
/.claude/

# Workflow scratch and outputs (demo workflows)
.nextflow/
.nextflow.log*
.snakemake/
**/demo/*/work/
**/demo/*/results/
