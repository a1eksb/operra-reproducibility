// Configures the Docker Compose-based RStudio development environment used by VS Code and Codespaces.
{
  "name": "Operra - RStudio (project-wide)",
  "dockerComposeFile": [
    "../docker-compose.yaml",
    "docker-compose.codespaces.yaml"
  ],
  "service": "pyverse",
  "workspaceFolder": "/home/rstudio/project",
  "shutdownAction": "stopCompose",
  "postStartCommand": "bash -c 'until curl -s --max-time 5 http://localhost:8787 >/dev/null 2>&1; do sleep 2; done && sleep 5'",
  "waitFor": "postStartCommand",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "RStudio",
      "onAutoForward": "silent",
      "visibility": "private",
      "protocol": "http"
    },
    "8787": {
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
